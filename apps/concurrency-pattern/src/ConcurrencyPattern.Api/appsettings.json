{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "ConcurrencyPattern": "Debug"
    }
  },
  "AllowedHosts": "*",
  "UseInMemoryDatabase": true,
  "UseRedisQueue": false,
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=ConcurrencyPatternDb;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "InstanceName": "ConcurrencyPattern",
    "CommandTimeoutSeconds": 30,
    "LockExpirySeconds": 30,
    "ConsumerGroup": "command-processors",
    "ConsumerName": "",
    "UseStrandMode": false,
    "UseEventDrivenStrand": false,
    "StrandLeaseSeconds": 30,
    "StrandBatchTimeoutSeconds": 5,
    "StrandMaxBatchSize": 100,
    "StrandDiscoveryIntervalSeconds": 2,
    "StrandMaxIdleIterations": 100
  }
}
